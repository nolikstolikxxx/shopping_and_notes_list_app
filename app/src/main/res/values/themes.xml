        <item name="colorError">@color/in_theme_error</item>
        <item name="colorOnError">@color/in_theme_onError</item>
    </style>

    <!-- Lime -->
    <style name="Theme.shoppingAndNotesListApp.Lime" parent="Theme.shoppingAndNotesListApp">
        <item name="colorPrimary">@color/li_theme_primary</item>
        <item name="colorOnPrimary">@color/li_theme_onPrimary</item>
        <item name="colorPrimaryContainer">@color/li_theme_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/li_theme_onPrimaryContainer</item>

        <item name="colorSecondary">@color/li_theme_secondary</item>
        <item name="colorOnSecondary">@color/li_theme_onSecondary</item>
        <item name="colorSecondaryContainer">@color/li_theme_secondaryContainer</item>
